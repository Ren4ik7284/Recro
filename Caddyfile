(common) {
    header ?Access-Control-Allow-Origin *
    header ?Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    header ?Access-Control-Allow-Headers *
    header ?Access-Control-Expose-Headers *

    handle /recro.apk {
        root * /var/www/recro/frontend
        header Content-Type application/vnd.android.package-archive
        header Content-Disposition "attachment; filename=recro.apk"
        file_server
    }

    handle /recro.ipa {
        root * /var/www/recro/frontend
        header Content-Type application/octet-stream
        header Content-Disposition "attachment; filename=recro.ipa"
        file_server
    }

    handle_path /cache/* {
        root * /var/www/recro/cache
        header {
            Cache-Control "public, max-age=604800, immutable"
        }
        file_server
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8085 {
            flush_interval -1
        }
    }

    handle {
        root * /var/www/recro/frontend
        try_files {path} {path}/ /index.html
        @nocache path /index.html /sw.js /manifest.json /manifest.webmanifest /
        header @nocache {
            Cache-Control "no-cache, no-store, must-revalidate"
            Pragma "no-cache"
            Expires "0"
        }
        file_server {
            precompressed gzip
        }
    }
}

recro.80.87.202.157.sslip.io, 80-87-202-157.sslip.io {
    import common
}

http://80.87.202.157, http://recro.80.87.202.157.sslip.io, http://80-87-202-157.sslip.io, :80 {
    import common
}


